{
  "name": "@googleworkspace/google-docs-hast",
  "version": "1.1.0",
  "type": "module",
  "description": "Convert a Google Doc JSON representation to an HTML abstract syntax tree.",
  "main": "dist/index.js",
  "types": "dist/src/index.d.ts",
  "homepage": "https://github.com/googleworkspace/google-docs-hast",
  "repository": {
    "type": "git",
    "url": "https://github.com/googleworkspace/google-docs-hast.git"
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly && esbuild src/index.ts --format=esm --outfile=dist/index.js --sourcemap --bundle",
    "docs": "typedoc --options typedoc.cjs && cp assets/logo.jpg docs/assets/logo.jpg",
    "format": "eslint . --fix",
    "lint": "eslint .",
    "prepare": "npm run build",
    "test": "vitest"
  },
  "files": [
    "src",
    "dist"
  ],
  "keywords": [
    "google",
    "docs",
    "hast",
    "html",
    "unified"
  ],
  "author": {
    "name": "Justin Poehnelt",
    "email": "jpoehnelt@google.com"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://wombat-dressing-room.appspot.com"
  },
  "devDependencies": {
    "@es-joy/jsdoccomment": "^0.83.0",
    "@googleapis/docs": "^9.2.0",
    "@types/node": "^25.0.10",
    "@types/prettier": "^2.7.3",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "c8": "^10.1.3",
    "csstype": "^3.2.3",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^62.3.1",
    "eslint-plugin-prettier": "^5.5.5",
    "googleapis": "^170.1.0",
    "hast-util-to-mdast": "^10.1.2",
    "prettier": "^3.8.1",
    "rehype-stringify": "^10.0.1",
    "remark-stringify": "^11.0.0",
    "typedoc": "^0.28.16",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "hast-util-to-string": "^3.0.1",
    "hastscript": "^9.0.1"
  }
}
